+std::string npc::avoid_immediate_danger()
+{
+    // Called from lua_ai after regen_ai_cache. Do not run the general selector:
+    // it may reintroduce a hidden combat target into a memory-driven search.
+    const int before = get_moves();
+    if( !in_vehicle && ( sees_dangerous_field( bub_pos() ) ||
+                         has_effect( effect_npc_fire_bad ) ) ) {
+        path.clear();
+        const auto escape = good_escape_direction( sees_dangerous_field( bub_pos() ) );
+        if( escape != bub_pos() && escape.z() == bub_pos().z() &&
+            get_map().inbounds( escape ) && g->critter_at( escape ) == nullptr ) {
+            move_to( escape, true, nullptr );
+        }
+        if( get_moves() >= before ) {
+            mod_moves( -100 );
+        }
+        return "field";
+    }
+    if( !ai_cache.dangerous_explosives.empty() ) {
+        path.clear();
+        escape_explosion();
+        if( get_moves() >= before ) {
+            mod_moves( -100 );
+        }
+        return "explosive";
+    }
+    return "";
+}
