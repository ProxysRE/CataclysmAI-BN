diff --git a/src/catalua_bindings_creature.cpp b/src/catalua_bindings_creature.cpp
--- a/src/catalua_bindings_creature.cpp
+++ b/src/catalua_bindings_creature.cpp
@@ -27,2 +27,3 @@
 #include "json.h"
+#include "line.h"
 #include "magic/magic.h"
@@ -1597,2 +1598,194 @@
+        DOC( "Whether the empty wielded gun can be reloaded from actual inventory." );
+        luna::set_fx( ut, "can_reload_empty_gun", []( UT_CLASS & npchar ) -> bool {
+            return !npchar.is_hallucination() && !npchar.in_vehicle &&
+                   !npchar.has_effect( efftype_id( "npc_run_away" ) ) &&
+                   npchar.primary_weapon().is_gun() && !npchar.primary_weapon().ammo_sufficient() &&
+                   npchar.can_reload_current();
+        } );
+
+        // map::sees caches a reciprocal pair but traces the first caller's
+        // direction. Check both zero-slope rays directly for stable cover.
+        const auto reload_ray_open = []( const tripoint_bub_ms &from, const tripoint_bub_ms &to ) -> bool {
+            auto &here = get_map();
+            if( from.z() != to.z() || !here.inbounds( from ) || !here.inbounds( to ) ) {
+                return true; // Unknown geometry is never accepted as cover.
+            }
+            bool open = true;
+            auto last = from.xy();
+            bresenham( from.xy().raw(), to.xy().raw(), 0, [&]( const point &next ) {
+                if( next == to.xy().raw() ) {
+                    return false;
+                }
+                const tripoint_bub_ms p( point_bub_ms( next ), from.z() );
+                if( !here.is_transparent( p ) ||
+                    here.obscured_by_vehicle_rotation( tripoint_bub_ms( last, from.z() ), p ) ) {
+                    open = false;
+                    return false;
+                }
+                last = point_bub_ms( next );
+                return true;
+            } );
+            return open;
+        };
+        const auto reload_cover_blocks_rays = [reload_ray_open]( const tripoint_bub_ms &a,
+        const tripoint_bub_ms &b ) {
+            return !reload_ray_open( a, b ) && !reload_ray_open( b, a );
+        };
+
+        const auto evaluate_reload_cover = [reload_cover_blocks_rays]( UT_CLASS & npchar, const tripoint_abs_ms & observed,
+        sol::optional<tripoint_abs_ms> committed, std::string &why ) -> std::optional<tripoint_abs_ms> {
+            if( !npchar.primary_weapon().is_gun() || npchar.primary_weapon().ammo_sufficient() ) {
+                why = "weapon_not_empty"; return std::nullopt;
+            }
+            if( !npchar.can_reload_current() ) {
+                why = "no_ammunition"; return std::nullopt;
+            }
+            if( npchar.in_vehicle || npchar.has_effect( efftype_id( "npc_run_away" ) ) ) {
+                why = "disabled"; return std::nullopt;
+            }
+            const Creature *target = npchar.current_target();
+            if( !committed && ( !target || !npchar.sees( *target ) || target->abs_pos() != observed ) ) {
+                why = "no_visible_target"; return std::nullopt;
+            }
+            auto &here = get_map();
+            const auto origin = npchar.bub_pos();
+            const auto foe = abs_to_bub( observed );
+            if( foe.z() != origin.z() || !here.inbounds( foe ) ||
+                ( !committed && ( rl_dist( origin, foe ) < 4 || rl_dist( origin, foe ) > 12 ) ) ) {
+                why = "invalid_threat_range"; return std::nullopt;
+            }
+            const auto avoid = npchar.get_legacy_path_avoid();
+            const auto score = [&]( const tripoint_bub_ms &candidate ) -> std::optional<int> {
+                if( !here.inbounds( candidate ) || candidate.z() != origin.z() ) {
+                    why = "invalid_cover_position"; return std::nullopt;
+                }
+                if( !here.passable( candidate ) || here.dangerous_field_at( candidate ) ) {
+                    why = "blocked_or_dangerous_cover"; return std::nullopt;
+                }
+                if( rl_dist( candidate, foe ) < 4 ) {
+                    why = "cover_too_close"; return std::nullopt;
+                }
+                if( !reload_cover_blocks_rays( foe, candidate ) ) {
+                    why = "exposed_cover"; return std::nullopt;
+                }
+                if( candidate != origin && g->critter_at( candidate ) != nullptr ) {
+                    why = "occupied_cover"; return std::nullopt;
+                }
+                auto route = here.route( origin, candidate, npchar.get_legacy_pathfinding_settings( true ), avoid );
+                if( candidate != origin && route.empty() ) {
+                    why = "no_route"; return std::nullopt;
+                }
+                for( const auto &p : route ) {
+                    if( p.z() != origin.z() || here.dangerous_field_at( p ) ) {
+                        why = "unsafe_route"; return std::nullopt;
+                    }
+                }
+                if( !route.empty() && route.front() == origin ) {
+                    route.erase( route.begin() );
+                }
+                if( route.size() > 3 ) {
+                    why = "route_too_long"; return std::nullopt;
+                }
+                why = "valid";
+                return 100 - 10 * static_cast<int>( route.size() );
+            };
+            if( committed ) {
+                return score( abs_to_bub( *committed ) ) ? std::optional<tripoint_abs_ms>( *committed ) : std::nullopt;
+            }
+            int best_score = 0;
+            std::optional<tripoint_abs_ms> best;
+            for( int x = -2; x <= 2; ++x ) {
+                for( int y = -2; y <= 2; ++y ) {
+                    const tripoint_bub_ms candidate( origin.x() + x, origin.y() + y, origin.z() );
+                    const auto rating = score( candidate );
+                    if( rating && *rating > best_score ) {
+                        best_score = *rating;
+                        best = bub_to_abs( candidate );
+                    }
+                }
+            }
+            return best;
+        };
+
+        DOC( "Choose or validate short reload cover without moving or reading a hidden target position." );
+        luna::set_fx( ut, "choose_reload_cover", [evaluate_reload_cover]( UT_CLASS & npchar,
+        const tripoint_abs_ms &observed, sol::optional<tripoint_abs_ms> committed ) -> std::optional<tripoint_abs_ms> {
+            std::string why;
+            return evaluate_reload_cover( npchar, observed, committed, why );
+        } );
+        DOC( "Explain validation of one committed reload-cover point without side effects." );
+        luna::set_fx( ut, "reload_cover_status", [evaluate_reload_cover]( UT_CLASS & npchar,
+        const tripoint_abs_ms &observed, const tripoint_abs_ms &committed ) -> std::string {
+            std::string why;
+            evaluate_reload_cover( npchar, observed, sol::optional<tripoint_abs_ms>( committed ), why );
+            return why;
+        } );
+
+        DOC( "Reload an empty gun from actual inventory without a currently visible selected target. Caller must have no fresh visual/sound contact and execute hazard avoidance first. Not a cover or all-threat safety guarantee." );
+        luna::set_fx( ut, "reload_without_visible_target", []( UT_CLASS & npchar ) -> bool {
+            const auto refuse = [&]( const std::string &reason ) {
+                npchar.set_value( "trkv_reload_result", reason );
+                return false;
+            };
+            const Creature *target = npchar.current_target();
+            if( target && npchar.sees( *target ) ) {
+                return refuse( "visible_target" );
+            }
+            if( get_map().dangerous_field_at( npchar.bub_pos() ) ) {
+                return refuse( "dangerous_field" );
+            }
+            if( npchar.is_hallucination() || npchar.in_vehicle || npchar.has_effect( efftype_id( "npc_run_away" ) ) ) {
+                return refuse( "disabled" );
+            }
+            if( !npchar.primary_weapon().is_gun() || npchar.primary_weapon().ammo_sufficient() ) {
+                return refuse( "weapon_not_empty" );
+            }
+            if( !npchar.can_reload_current() ) {
+                return refuse( "no_ammunition" );
+            }
+            const int before = npchar.get_moves();
+            npchar.do_reload( npchar.primary_weapon() );
+            const bool spent_moves = npchar.get_moves() < before;
+            npchar.set_value( "trkv_reload_result", spent_moves ? "idle_reloaded" : "no_action" );
+            return spent_moves;
+        } );
+
+        DOC( "Reload the empty wielded gun using BN costs and inventory, only outside terrain LOS from the observed threat and with no currently visible selected target. Returns whether moves were spent." );
+        luna::set_fx( ut, "reload_under_cover", [reload_cover_blocks_rays]( UT_CLASS & npchar, const tripoint_abs_ms & observed ) -> bool {
+            auto &here = get_map();
+            const auto foe = abs_to_bub( observed );
+            const Creature *target = npchar.current_target();
+            const auto refuse = [&]( const std::string &reason ) {
+                npchar.set_value( "trkv_reload_result", reason );
+                return false;
+            };
+            if( !here.inbounds( foe ) || foe.z() != npchar.bub_pos().z() ) {
+                return refuse( "invalid_threat_position" );
+            }
+            if( !reload_cover_blocks_rays( foe, npchar.bub_pos() ) ) {
+                return refuse( "exposed" );
+            }
+            if( here.dangerous_field_at( npchar.bub_pos() ) ) {
+                return refuse( "dangerous_field" );
+            }
+            if( target && npchar.sees( *target ) ) {
+                return refuse( "visible_target" );
+            }
+            if( !npchar.primary_weapon().is_gun() || npchar.primary_weapon().ammo_sufficient() ) {
+                return refuse( "weapon_not_empty" );
+            }
+            if( !npchar.can_reload_current() ) {
+                return refuse( "no_ammunition" );
+            }
+            if( npchar.is_hallucination() || npchar.in_vehicle || npchar.has_effect( efftype_id( "npc_run_away" ) ) ) {
+                return refuse( "disabled" );
+            }
+            const int before = npchar.get_moves();
+            npchar.do_reload( npchar.primary_weapon() );
+            const bool spent_moves = npchar.get_moves() < before;
+            npchar.set_value( "trkv_reload_result", spent_moves ? "reloaded" : "no_action" );
+            return spent_moves;
+        } );
+
         DOC( "Triggers the npc menu to open." );
         luna::set_fx( ut, "npc_menu", []( UT_CLASS & npchar, sol::optional<bool> force ) -> void { g->npc_menu( npchar, force.value_or( false ) ); } );
