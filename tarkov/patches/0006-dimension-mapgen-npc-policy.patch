-const world_type_id &world_types::get_default()
-{
-    return default_world_type_id;
-}
+const world_type_id &world_types::get_default()
+{
+    return default_world_type_id;
+}
+
+world_type_id world_types::infer_from_dimension( const dimension_id &dim )
+{
+    auto result = get_default();
+    if( !dim.is_empty() ) {
+        for( const auto &type : get_all() ) {
+            if( !type.save_prefix.empty() && dim.str().starts_with( type.save_prefix ) ) {
+                result = type.id;
+            }
+        }
+    }
+    return result;
+}
