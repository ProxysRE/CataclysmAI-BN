+// Explicit initial attributes. Loaded only at creation; saves own later changes.
+struct npc_attribute_profile {
+    int strength;
+    int dexterity;
+    int intelligence;
+    int perception;
+    int aggression;
+    int bravery;
+    int collector;
+    int altruism;
+    std::map<std::string, int> hit_points;
+};
+
 class npc_class
