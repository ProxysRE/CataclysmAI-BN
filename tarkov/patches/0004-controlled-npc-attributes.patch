diff --git a/src/npc_class.cpp b/src/npc_class.cpp
--- a/src/npc_class.cpp
+++ b/src/npc_class.cpp
@@ -241,2 +241,32 @@
     assign( jo, "lua_ai", lua_ai );
+    if( jo.has_member( "attribute_profile" ) ) {
+        const JsonObject profile = jo.get_object( "attribute_profile" );
+        const JsonObject stats = profile.get_object( "stats" );
+        const JsonObject character = profile.get_object( "personality" );
+        const auto read_value = []( const JsonObject & obj, const std::string & key,
+        int minimum, int maximum ) {
+            const int value = obj.get_int( key );
+            if( value < minimum || value > maximum ) {
+                obj.throw_error( "Attribute profile value out of range", key );
+            }
+            return value;
+        };
+        attribute_profile = npc_attribute_profile{
+            read_value( stats, "strength", 1, 100 ),
+            read_value( stats, "dexterity", 1, 100 ),
+            read_value( stats, "intelligence", 1, 100 ),
+            read_value( stats, "perception", 1, 100 ),
+            read_value( character, "aggression", -100, 100 ),
+            read_value( character, "bravery", -100, 100 ),
+            read_value( character, "collector", -100, 100 ),
+            read_value( character, "altruism", -100, 100 ),
+            {}
+        };
+        if( profile.has_member( "hit_points" ) ) {
+            const JsonObject hp = profile.get_object( "hit_points" );
+            for( const char *part : { "head", "torso", "arm_l", "arm_r", "leg_l", "leg_r" } ) {
+                attribute_profile->hit_points[part] = read_value( hp, part, 1, 10000 );
+            }
+        }
+    }
 
