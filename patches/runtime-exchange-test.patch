+TEST_CASE( "cataclysm_ai_python_echo_round_trip", "[lua][cataclysm_ai]" )
+{
+    auto lua = make_lua_state();
+
+    const auto config_dir = PATH_INFO::config_dir();
+    std::filesystem::create_directories( config_dir );
+
+    const auto request_path = config_dir + "cataclysm_ai_request.txt";
+    const auto response_path = config_dir + "cataclysm_ai_response.txt";
+    std::remove( request_path.c_str() );
+    std::remove( response_path.c_str() );
+
+    const auto loaded = lua.load( "return cataclysm_ai.exchange('Кто ты?', 5000)" );
+    REQUIRE( loaded.valid() );
+
+    const auto result = sol::protected_function( loaded )();
+    const auto result_valid = result.valid();
+    std::string response;
+    if( result_valid ) {
+        response = result.get<std::string>();
+    }
+
+    std::remove( request_path.c_str() );
+    std::remove( response_path.c_str() );
+
+    REQUIRE( result_valid );
+    CHECK( response == "[ECHO] Кто ты?" );
+}
 
