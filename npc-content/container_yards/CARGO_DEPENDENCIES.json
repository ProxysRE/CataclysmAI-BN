      {
        "id": "menstrual_pad2",
        "text": "A small panty-liner only meant for the lightest flows."
      },
      {
        "id": "menstrual_pad3",
        "text": "A large menstrual pad meant for use overnight."
      },
      {
        "id": "menstrual_pad4",
        "text": "An absorbent menstrual pad with racing stripes, for the fastest flows.  Probably."
      },
      {
