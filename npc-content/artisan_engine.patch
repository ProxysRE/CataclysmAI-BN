+auto faction::food_supply_kcal() const -> std::int64_t
+{
+    if( dda_food_supply.empty() ) {
+        return food_supply;
+    }
+    auto calories = std::int64_t{ 0 };
+    for( const auto &lot : dda_food_supply ) {
+        if( lot.calories > std::numeric_limits<std::int64_t>::max() - calories ) {
+            return std::numeric_limits<std::int64_t>::max() / 1000;
+        }
+        calories += lot.calories;
+    }
+    return calories / 1000;
+}
