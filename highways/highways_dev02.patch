index 0000000..6f36a1d
--- /dev/null
+++ b/utilities/highway/generate_overpasses.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Reproduce DEV0.2 mapgens: 15-square carriageways, paired ramps and two-level crossings."""
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+base = json.loads((ROOT / 'data/json/mapgen/bn_highways.json').read_text())
+base = {entry['om_terrain']: entry['object']['rows'] for entry in base}
+mapgens, terrains = [], []
+GROUND = {'g': 't_grass', '.': 't_pavement', '*': 't_pavement_y', '|': 't_guardrail',
+          '#': 't_concrete_wall', 'u': 't_ramp_up_low', 'U': 't_ramp_up_high'}
+DECK = {'g': 't_open_air', '.': 't_pavement_hw_air', '*': 't_pavement_y_hw_air',
+        '|': 't_guardrail_hw_air', 'D': 't_ramp_down_low', 'd': 't_ramp_down_high'}
+
+
+def transpose(rows):
+    return [''.join(row[x] for row in rows) for x in range(24)]
+
+
+def add(name, rows, palette, elevated=False):
+    mapgens.append({'type': 'mapgen', 'om_terrain': name, 'method': 'json',
+                    'object': {'fill_ter': palette['g'], 'rows': rows, 'terrain': palette}})
+    terrains.append({'type': 'overmap_terrain', 'id': name, 'copy-from': 'generic_transportation',
+                     'name': ('highway, elevated roadway' if elevated else
+                              'highway, approach' if '_ramp_' in name else
+                              'highway, underpass'),
+                     'sym': '\u2502' if '_ns_' in name else '\u2500',
+                     'color': 'light_cyan' if elevated else 'light_gray',
+                     'see_cost': 2, 'looks_like': 'hiway_ns' if '_ns_' in name else 'hiway_ew',
+                     'flags': ['NO_ROTATE']})
+
+
+for half, lo, hi in [('w', 8, 22), ('e', 1, 15)]:
+    straight = base['bn_highway_ns_' + half]
+    for orientation, target_half in [('ns', half), ('ew', 'n' if half == 'w' else 's')]:
+        orient = (lambda rows: rows) if orientation == 'ns' else transpose
+        prefix = 'bn_highway_' + orientation + '_' + target_half
+        add(prefix + '_deck', orient(straight), DECK, True)
+        for crossing in [False, True]:
+            rows = [['g'] * 24 for _ in range(24)]
+            if crossing:
+                for y in range(4, 20):
+                    rows[y] = ['.'] * 24
+                    if y in (11, 12):
+                        rows[y] = ['*' if x % 4 >= 2 else '.' for x in range(24)]
+            for y in (2, 21):
+                for x in (lo, hi):
+                    rows[y][x] = '#'
+            add(prefix + '_under' + ('_crossing' if crossing else ''),
+                orient([''.join(row) for row in rows]), GROUND)
+        for direction in ['up', 'down']:
+            ground, deck = [], []
+            for y in range(24):
+                bottom, top = list(straight[y]), ['g'] * 24
+                for x in range(lo - 1, hi + 2):
+                    if y > 12:
+                        bottom[x] = '#'
+                    if y >= 11:
+                        top[x] = '|' if x in (lo - 1, hi + 1) else (
+                            'D' if y == 11 else 'd' if y == 12 else straight[y][x])
+                    if lo <= x <= hi and y in (11, 12):
+                        bottom[x] = 'u' if y == 11 else 'U'
+                ground.append(''.join(bottom))
+                deck.append(''.join(top))
+            if direction == 'down':
+                ground.reverse()
+                deck.reverse()
+            add(prefix + '_ramp_' + direction + '_ground', orient(ground), GROUND)
+            add(prefix + '_ramp_' + direction + '_deck', orient(deck), DECK, True)
+
+for quadrant in ['nw', 'ne', 'sw', 'se']:
+    half = quadrant[0]
+    rows = [list(row) for row in base['bn_highway_ew_' + half]]
+    # Piers stand outside the lower highway's carriageway and guardrails.
+    for x in ((8, 22) if quadrant[1] == 'w' else (1, 15)):
+        rows[2 if half == 'n' else 21][x] = '#'
+    add('bn_highway_junction_' + quadrant + '_under', [''.join(row) for row in rows], GROUND)
+
+for path, content in [('data/json/mapgen/bn_highway_overpasses.json', mapgens),
+                      ('data/json/overmap/overmap_terrain/bn_highway_overpasses.json', terrains)]:
+    (ROOT / path).write_text(json.dumps(content, ensure_ascii=False, indent=2) + '\n')
+print(f'Generated {len(mapgens)} paired overpass templates')
