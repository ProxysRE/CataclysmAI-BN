+#!/usr/bin/env python3
+"""Verify 3D lane continuity, median seams, matched slopes and unobstructed underpasses."""
+import json
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[2]
+entries = json.loads((ROOT / 'data/json/mapgen/bn_highway_overpasses.json').read_text())
+terrains = json.loads((ROOT / 'data/json/overmap/overmap_terrain/bn_highway_overpasses.json').read_text())
+rows = {e['om_terrain']: e['object']['rows'] for e in entries}
+assert len(rows) == len(entries) == len(terrains) == 32
+assert set(rows) == {e['id'] for e in terrains}
+for e in entries:
+    name, obj = e['om_terrain'], e['object']
+    assert len(obj['rows']) == 24 and all(len(r) == 24 for r in obj['rows']), name
+    assert set(''.join(obj['rows'])) <= obj['terrain'].keys(), name
+
+
+def transpose(tile):
+    return [''.join(r[x] for r in tile) for x in range(24)]
+
+
+for half, lo, hi in [('w', 8, 22), ('e', 1, 15)]:
+    for suffix in ['deck', 'under', 'under_crossing', 'ramp_up_ground', 'ramp_up_deck',
+                   'ramp_down_ground', 'ramp_down_deck']:
+        assert transpose(rows[f'bn_highway_ns_{half}_{suffix}']) == rows[
+            f'bn_highway_ew_{"n" if half == "w" else "s"}_{suffix}']
+    deck = rows[f'bn_highway_ns_{half}_deck']
+    assert all(r[lo-1] == r[hi+1] == '|' for r in deck)
+    assert all(sum(c in '.*' for c in r) == 15 for r in deck)
+    for direction in ['up', 'down']:
+        low = rows[f'bn_highway_ns_{half}_ramp_{direction}_ground']
+        top = rows[f'bn_highway_ns_{half}_ramp_{direction}_deck']
+        if direction == 'down':
+            low, top = low[::-1], top[::-1]
+        for x in range(lo, hi+1):
+            assert low[11][x] == 'u' and low[12][x] == 'U'
+            assert top[11][x] == 'D' and top[12][x] == 'd'
+            assert all(low[y][x] in '.*' and top[y][x] == 'g' for y in range(11))
+            assert all(low[y][x] == '#' and top[y][x] in '.*' for y in range(13, 24))
+        assert top[-1].replace('*', '.') == deck[0].replace('*', '.')
+    under = rows[f'bn_highway_ns_{half}_under_crossing']
+    assert all(under[y][x] in '.*' for y in range(4,20) for x in range(24))
+ns = [a+b for a,b in zip(rows['bn_highway_ns_w_deck'], rows['bn_highway_ns_e_deck'])]
+assert all(r[23:25] == '||' for r in ns)
+ew = rows['bn_highway_ew_n_deck'] + rows['bn_highway_ew_s_deck']
+assert ew[23] == ew[24] == '|' * 24
+for rowhalf in 'ns':
+    for colhalf in 'we':
+        tile = rows[f'bn_highway_junction_{rowhalf}{colhalf}_under']
+        lo, hi = (8,22) if rowhalf == 'n' else (1,15)
+        assert all(tile[y][x] in '.*' for y in range(lo,hi+1) for x in range(24))
+        assert all(tile[y][x] == '|' for y in [lo-1, hi+1] for x in range(24))
+print('PASS: 32 mapgens; matched two-level ramps; 2x15 lanes; NS/EW medians; lower crossings')
