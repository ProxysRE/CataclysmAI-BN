+namespace {
+struct axis_options {
+    bool vertical;
+    int coordinate;
+    std::optional<int> junction;
+};
+
+auto elevate_axis(overmap& om, const axis_options& opts) -> void {
+    const auto extent = opts.vertical ? OMAPY : OMAPX;
+    auto input = std::vector<highway::elevation_input>(extent);
+    const auto position = [&](const auto i, const auto half) {
+        return opts.vertical ? tripoint_om_omt(opts.coordinate + half, i, 0)
+                             : tripoint_om_omt(i, opts.coordinate + half, 0);
+    };
+    using namespace std::views;
+    for (const auto i : iota(0, extent)) {
+        for (const auto half : iota(0, 2)) {
+            const auto pos = position(i, half);
+            const auto& terrain = om.ter(pos);
+            input[i].crossing = input[i].crossing || terrain.id().str().ends_with("_crossing");
+            input[i].blocked = input[i].blocked || terrain->is_river()
+                               || om.ter(pos + tripoint_above) != oter_id("open_air");
+        }
+        if (opts.junction) {
+            if (opts.vertical) {
+                input[i].junction = i == *opts.junction || i == *opts.junction + 1;
+            } else if (i >= *opts.junction - 3 && i <= *opts.junction + 4) {
+                // The east/west highway stays below the north/south flyover.
+                input[i].blocked = true;
+            }
+        }
+    }
+    if (opts.vertical && opts.junction) {
+        const auto j = *opts.junction;
+        // Either elevate the complete 2x2 crossing or retain its original mapgen.
+        if (std::ranges::any_of(iota(j - 1, j + 3), [&](const auto i) { return input[i].blocked; })) {
+            input[j].blocked = input[j + 1].blocked = true;
+        }
+    }
+    const auto plan = highway::plan_elevation(input);
+    for (const auto i : iota(0, extent)) {
+        if (plan[i] == highway::elevation::ground) { continue; }
+        for (const auto half : iota(0, 2)) {
+            const auto pos = position(i, half);
+            const auto prefix = std::string("bn_highway_")
+                                + (opts.vertical ? (half == 0 ? "ns_w" : "ns_e")
+                                                 : (half == 0 ? "ew_n" : "ew_s"));
+            auto ground = prefix + "_under";
+            auto above = prefix + "_deck";
+            if (plan[i] == highway::elevation::ascend || plan[i] == highway::elevation::descend) {
+                const auto ramp = plan[i] == highway::elevation::ascend ? "_ramp_up" : "_ramp_down";
+                ground = prefix + ramp + "_ground";
+                above = prefix + ramp + "_deck";
+            } else if (input[i].junction) {
+                ground = "bn_highway_junction_"
+                         + std::string(i == *opts.junction ? "n" : "s")
+                         + (half == 0 ? "w_under" : "e_under");
+            } else if (input[i].crossing) {
+                ground += "_crossing";
+            }
+            om.ter_set(pos, oter_id(ground));
+            om.ter_set(pos + tripoint_above, oter_id(above));
+        }
+    }
+}
+} // namespace
+
+auto highway::elevate(overmap& om, const std::vector<reserved_tile>& tiles) -> void {
+    auto vertical = std::optional<int>();
+    auto horizontal = std::optional<int>();
+    for (const auto& tile : tiles) {
+        if (tile.kind == tile_kind::north_south_west) { vertical = tile.pos.x(); }
+        if (tile.kind == tile_kind::east_west_north) { horizontal = tile.pos.y(); }
+    }
+    if (vertical) {
+        elevate_axis(om, {.vertical = true, .coordinate = *vertical, .junction = horizontal});
+    }
+    if (horizontal) {
+        elevate_axis(om, {.vertical = false, .coordinate = *horizontal, .junction = vertical});
+    }
+}
