+        for (const auto i : iota(0, 180)) {
+            assert(!input[i].blocked || plan[i] == ground);
+            assert(!input[i].crossing || plan[i] == ground || plan[i] == deck);
+            if (plan[i] == ascend) {
+                assert(!elevated && plan[i + 1] == deck);
+                elevated = true;
+            } else if (plan[i] == descend) {
+                assert(elevated && plan[i - 1] == deck);
+                elevated = false;
+            } else {
+                assert((plan[i] == deck) == elevated);
+            }
+        }
+        assert(!elevated);
+        (void)iteration;
+    }
+    auto input = std::vector<highway::elevation_input>(180);
+    for (const auto y : std::array{18, 22, 25, 28, 30, 34, 36, 39, 42, 95, 97, 100, 136, 137, 148, 167}) {
+        input[y].crossing = true;
+    }
+    input[59].junction = input[60].junction = true;
+    input[12].blocked = true;
+    const auto plan = highway::plan_elevation(input);
+    std::cout << "PASS: 10,000 reproducible network layouts; original save's NS crossings:\n";
+    for (const auto i : iota(0, 180)) {
+        if (plan[i] != ground || input[i].crossing) {
+            std::cout << i << ':' << static_cast<int>(plan[i]) << ' ';
+        }
+    }
+    std::cout << '\n';
+}
