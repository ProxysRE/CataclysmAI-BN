+#include "catch/catch.hpp"
+#include "overmap/highway_elevation.h"
+
+#include <random>
+#include <ranges>
+
+TEST_CASE("highway_elevation_preserves_access_and_merges_nearby_crossings", "[highway]") {
+    auto input = std::vector<highway::elevation_input>(180);
+    input[18].crossing = input[22].crossing = input[25].crossing = true;
+    input[59].junction = input[60].junction = true;
+    const auto plan = highway::plan_elevation(input);
+    using enum highway::elevation;
+    CHECK(plan[18] == ground);
+    CHECK(plan[21] == ascend);
+    CHECK(plan[22] == deck);
+    CHECK(plan[23] == descend);
+    CHECK(plan[25] == ground);
+    CHECK(plan[58] == ascend);
+    CHECK(plan[59] == deck);
+    CHECK(plan[60] == deck);
+    CHECK(plan[61] == descend);
+}
+
+TEST_CASE("highway_elevation_never_leaves_an_open_ended_viaduct", "[highway]") {
+    auto random = std::mt19937(602);
+    using namespace std::views;
+    using enum highway::elevation;
+    // Dense roads, water, occupied upper levels and overmap edges in reproducible combinations.
+    for (const auto iteration : iota(0, 2000)) {
+        INFO(iteration);
+        auto input = std::vector<highway::elevation_input>(180);
+        for (auto& value : input) {
+            value.crossing = random() % 5 == 0;
+            value.blocked = random() % 17 == 0;
+        }
+        const auto plan = highway::plan_elevation(input);
+        CHECK(plan.front() == ground);
+        CHECK(plan.back() == ground);
+        auto on_deck = false;
+        for (const auto i : iota(0, 180)) {
+            CAPTURE(i);
+            if (input[i].blocked) { CHECK(plan[i] == ground); }
+            if (input[i].crossing) {
+                CHECK((plan[i] == ground || plan[i] == deck));
+            }
+            if (plan[i] == ascend) {
+                CHECK_FALSE(on_deck);
+                REQUIRE(i + 1 < 180);
+                CHECK(plan[i + 1] == deck);
+                on_deck = true;
+            } else if (plan[i] == descend) {
+                CHECK(on_deck);
+                REQUIRE(i > 0);
+                CHECK(plan[i - 1] == deck);
+                on_deck = false;
+            } else if (plan[i] == deck) {
+                CHECK(on_deck);
+            } else {
+                CHECK_FALSE(on_deck);
+            }
+        }
+        CHECK_FALSE(on_deck);
+    }
+}
