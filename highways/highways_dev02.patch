diff --git a/docs/en/dev/explanation/highway_overpasses.md b/docs/en/dev/explanation/highway_overpasses.md
new file mode 100644
index 0000000..9af8ef9
--- /dev/null
+++ b/docs/en/dev/explanation/highway_overpasses.md
@@ -0,0 +1,36 @@
+# Highway DEV0.2: grade separation preview
+
+Applies after the tested DEV0.1 foundation on BN c621aaf42fa182473aad10feea2b55647704dcf1.
+
+North/south highways pass above east/west highways at their 2x2 crossing. Both
+carriageways ascend together before the crossing and descend together after it.
+The lower highway retains its 15-square carriageways and closed central median.
+
+Selected local-road crossings pass beneath the highway. Crossings separated by
+up to three overmap squares share one elevated segment. The first eligible local
+crossing in each 24-square district remains an at-grade access point. Other
+crossings remain at grade where there is no safe approach space. An approach
+never replaces a retained local road. Dedicated interchange exit ramps are not
+implemented in this preview; the highway's approaches change its elevation.
+
+All raised sections begin and end within their overmap. Water and existing
+upper-level specials block elevation. Paired water crossings now reserve a flat
+bridge for both highway halves and cannot turn into a surface local intersection.
+Longer raised water bridges and highway routing around towns remain future work.
+
+Mapgens reuse BN's vehicle ramp terrain and concrete bridge deck terrain. New
+IDs are additive: DEV0.1 IDs remain available for existing saves. Generated
+terrain is not retroactively replaced. Test in a new world with BN_HIGHWAYS on,
+spacing 3, or in previously ungenerated territory. Keep world options unchanged.
+
+Validation:
+
+- `python utilities/highway/check_mapgen.py`: original foundation geometry.
+- `python utilities/highway/check_overpasses.py`: all 32 new mapgens, lane widths,
+  medians, paired slopes, unobstructed lower roads and rotated geometry.
+- `g++ -std=c++23 utilities/highway/check_elevation.cpp -o check_elevation`:
+  standalone planner checks across 10,000 reproducible layouts and the original
+  test save's crossing coordinates.
+- Build the game and `cata_test-tiles`, then run `[highway],[vehicle][ramp]`.
+  Native tests explicitly enable real mapgen and drive a motorcycle over the
+  generated approaches in both directions for all four carriageway templates.
diff --git a/src/overmap/highway_elevation.h b/src/overmap/highway_elevation.h
new file mode 100644
index 0000000..1ec4d93
--- /dev/null
+++ b/src/overmap/highway_elevation.h
@@ -0,0 +1,74 @@
+#pragma once
+
+#include <algorithm>
+#include <ranges>
+#include <vector>
+
+namespace highway {
+enum class elevation { ground, ascend, deck, descend };
+
+struct elevation_input {
+    bool crossing = false;
+    bool junction = false;
+    bool blocked = false;
+};
+
+/// Keep surface access in each district; merge nearby overpasses into one viaduct.
+/// Every elevated run has two approaches entirely inside this overmap.
+inline auto plan_elevation(const std::vector<elevation_input>& input) -> std::vector<elevation> {
+    const auto size = static_cast<int>(input.size());
+    auto result = std::vector<elevation>(size, elevation::ground);
+    if (size < 5) { return result; }
+    auto blocked = std::vector<bool>(size);
+    using namespace std::views;
+    for (const auto i : iota(0, size)) { blocked[i] = input[i].blocked; }
+    blocked[0] = blocked[size - 1] = true;
+    // Access points remain at grade until dedicated interchange ramps are available.
+    auto district = -1;
+    for (const auto i : iota(0, size)) {
+        const auto near_junction = std::ranges::any_of(
+            iota(std::max(0, i - 4), std::min(size, i + 5)),
+            [&](const auto j) { return input[j].junction; });
+        if (input[i].crossing && !input[i].junction && !near_junction && i / 24 != district) {
+            blocked[i] = true;
+            district = i / 24;
+        }
+    }
+    auto candidates = std::vector<int>();
+    // A retained crossing must never become an embankment approach for its neighbor.
+    // Propagate this constraint through contiguous groups until both ends have room.
+    auto changed = true;
+    while (changed) {
+        changed = false;
+        for (const auto i : iota(1, size - 1)) {
+            if ((input[i].crossing || input[i].junction) && !blocked[i]
+                && (i < 2 || i >= size - 2 || blocked[i - 1] || blocked[i + 1])) {
+                blocked[i] = true;
+                changed = true;
+            }
+        }
+    }
+    for (const auto i : iota(2, size - 2)) {
+        if ((input[i].crossing || input[i].junction) && !blocked[i]) { candidates.push_back(i); }
+    }
+    auto first = -1;
+    auto last = -1;
+    const auto emit = [&]() {
+        if (first < 0) { return; }
+        result[first - 1] = elevation::ascend;
+        for (const auto i : iota(first, last + 1)) { result[i] = elevation::deck; }
+        result[last + 1] = elevation::descend;
+    };
+    for (const auto i : candidates) {
+        if (first >= 0 && (i - last > 3 || std::ranges::any_of(
+                iota(last, i + 1), [&](const auto j) { return blocked[j]; }))) {
+            emit();
+            first = -1;
+        }
+        if (first < 0) { first = i; }
+        last = i;
+    }
+    emit();
+    return result;
+}
+} // namespace highway
