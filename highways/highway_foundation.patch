new file mode 100644
index 0000000..36d3f32
--- /dev/null
+++ b/src/overmap/highway_grid.cpp
@@ -0,0 +1,47 @@
+#include "highway_grid.h"
+
+#include <cstdint>
+
+namespace {
+auto axis_offset(int coordinate, int extent) -> int {
+    // Defined unsigned arithmetic also handles negative world coordinates.
+    auto mixed = static_cast<std::uint32_t>(coordinate);
+    mixed ^= mixed >> 16;
+    mixed *= 0x7feb352dU;
+    mixed ^= mixed >> 15;
+    mixed *= 0x846ca68bU;
+    mixed ^= mixed >> 16;
+    const auto variance = extent / 6;
+    return extent / 2 - 1 + static_cast<int>(mixed % (2 * variance + 1)) - variance;
+}
+} // namespace
+
+auto highway::plan_grid(const grid_options& opts, int extent) -> grid {
+    auto result = grid{};
+    if (opts.spacing < 1 || extent < 12) { return result; }
+    if (opts.overmap_x % opts.spacing == 0) {
+        result.vertical = axis_offset(opts.overmap_x, extent);
+    }
+    if (opts.overmap_y % opts.spacing == 0) {
+        result.horizontal = axis_offset(opts.overmap_y, extent);
+    }
+    return result;
+}
+
+auto highway::grid::at(int x, int y) const -> tile_kind {
+    const auto on_vertical = vertical && (x == *vertical || x == *vertical + 1);
+    const auto on_horizontal = horizontal && (y == *horizontal || y == *horizontal + 1);
+    if (on_vertical && on_horizontal) {
+        if (y == *horizontal) {
+            return x == *vertical ? tile_kind::junction_north_west : tile_kind::junction_north_east;
+        }
+        return x == *vertical ? tile_kind::junction_south_west : tile_kind::junction_south_east;
+    }
+    if (on_vertical) {
+        return x == *vertical ? tile_kind::north_south_west : tile_kind::north_south_east;
+    }
+    if (on_horizontal) {
+        return y == *horizontal ? tile_kind::east_west_north : tile_kind::east_west_south;
+    }
+    return tile_kind::none;
+}
