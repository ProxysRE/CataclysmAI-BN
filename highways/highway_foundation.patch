diff --git a/src/overmap/highway_generation.cpp b/src/overmap/highway_generation.cpp
new file mode 100644
index 0000000..2a6cfe6
--- /dev/null
+++ b/src/overmap/highway_generation.cpp
@@ -0,0 +1,119 @@
+#include "highway_generation.h"
+
+#include "game_constants.h"
+#include "omdata.h"
+#include "overmap.h"
+
+#include <ranges>
+#include <string>
+#include <unordered_set>
+
+namespace {
+auto terrain_name(highway::tile_kind kind) -> std::string {
+    using enum highway::tile_kind;
+    switch (kind) {
+        case north_south_west:
+            return "bn_highway_ns_w";
+        case north_south_east:
+            return "bn_highway_ns_e";
+        case east_west_north:
+            return "bn_highway_ew_n";
+        case east_west_south:
+            return "bn_highway_ew_s";
+        case junction_north_west:
+            return "bn_highway_junction_nw";
+        case junction_north_east:
+            return "bn_highway_junction_ne";
+        case junction_south_west:
+            return "bn_highway_junction_sw";
+        case junction_south_east:
+            return "bn_highway_junction_se";
+        case none:
+            return "";
+    }
+    return "";
+}
+
+auto paired_position(const highway::reserved_tile& tile) -> tripoint_om_omt {
+    using enum highway::tile_kind;
+    switch (tile.kind) {
+        case north_south_west:
+            return tile.pos + tripoint_east;
+        case north_south_east:
+            return tile.pos + tripoint_west;
+        case east_west_north:
+            return tile.pos + tripoint_south;
+        case east_west_south:
+            return tile.pos + tripoint_north;
+        default:
+            return tile.pos;
+    }
+}
+
+auto local_road_crosses(const highway::reserved_tile& tile, const oter_id& terrain) -> bool {
+    if (!is_ot_match("road", terrain, ot_match_type::prefix)) { return false; }
+    using enum highway::tile_kind;
+    switch (tile.kind) {
+        case north_south_west:
+        case north_south_east:
+            return terrain->has_connection(om_direction::type::east)
+                || terrain->has_connection(om_direction::type::west);
+        case east_west_north:
+        case east_west_south:
+            return terrain->has_connection(om_direction::type::north)
+                || terrain->has_connection(om_direction::type::south);
+        default:
+            return true;
+    }
+}
+} // namespace
+
+auto highway::is_highway(const oter_id& terrain) -> bool {
+    return is_ot_match("bn_highway", terrain, ot_match_type::prefix);
+}
+
+auto highway::reserve(overmap& om, const grid_options& opts) -> std::vector<reserved_tile> {
+    auto result = std::vector<reserved_tile>();
+    // Other dimensions have their own world generation and must not inherit highways.
+    if (!om.get_dimension_id().str().empty()) { return result; }
+    const auto layout = plan_grid(opts, OMAPX);
+    if (!layout.vertical && !layout.horizontal) { return result; }
+    result.reserve((layout.vertical ? 2 * OMAPY : 0) + (layout.horizontal ? 2 * OMAPX : 0));
+    using namespace std::views;
+    for (const auto x : iota(0, OMAPX)) {
+        for (const auto y : iota(0, OMAPY)) {
+            const auto kind = layout.at(x, y);
+            if (kind == tile_kind::none) { continue; }
+            const auto pos = tripoint_om_omt(x, y, 0);
+            const auto& previous = om.ter(pos);
+            auto name = terrain_name(kind);
+            if (previous->is_river() || previous->is_lake() || previous->is_lake_shore()) {
+                name += "_bridge";
+            }
+            const auto terrain = oter_id(name);
+            om.ter_set(pos, terrain);
+            result.push_back({.pos = pos, .terrain = terrain, .kind = kind});
+        }
+    }
+    return result;
+}
+
+auto highway::finalize(overmap& om, const std::vector<reserved_tile>& tiles) -> void {
+    auto crossings = std::unordered_set<tripoint_om_omt>();
+    // A local road may replace a reservation. Open BOTH carriageways at its access point.
+    for (const auto& tile : tiles) {
+        if (local_road_crosses(tile, om.ter(tile.pos))
+            || (is_highway(om.ter(tile.pos))
+                && om.ter(tile.pos).id().str().ends_with("_crossing"))) {
+            crossings.insert(tile.pos);
+            crossings.insert(paired_position(tile));
+        }
+    }
+    for (const auto& tile : tiles) {
+        const auto terrain =
+            crossings.contains(tile.pos)
+                ? oter_id(terrain_name(tile.kind) + "_crossing")
+                : tile.terrain;
+        om.ter_set(tile.pos, terrain);
+    }
+}
