+#include "catch/catch.hpp"
+#include "game_constants.h"
+#include "overmap/highway_grid.h"
+
+#include <ranges>
+
+TEST_CASE("highway_grid_matches_all_neighbor_edges", "[highway][overmap]") {
+    using namespace std::views;
+    for (const auto spacing : iota(1, 9)) {
+        for (const auto x : iota(-12, 13)) {
+            for (const auto y : iota(-12, 13)) {
+                const auto center =
+                    highway::plan_grid({.overmap_x = x, .overmap_y = y, .spacing = spacing}, OMAPX);
+                const auto east = highway::
+                    plan_grid({.overmap_x = x + 1, .overmap_y = y, .spacing = spacing}, OMAPX);
+                const auto south = highway::
+                    plan_grid({.overmap_x = x, .overmap_y = y + 1, .spacing = spacing}, OMAPX);
+                for (const auto offset : iota(0, OMAPX)) {
+                    CHECK(center.at(OMAPX - 1, offset) == east.at(0, offset));
+                    CHECK(center.at(offset, OMAPY - 1) == south.at(offset, 0));
+                }
+            }
+        }
+    }
+}
