+#pragma once
+
+#include <optional>
+
+namespace highway {
+
+/// Foundation topology: independent of RNG state and overmap generation order.
+/// Spacing is measured in overmaps; coordinate zero always contains both axes.
+struct grid_options {
+    int overmap_x = 0;
+    int overmap_y = 0;
+    int spacing = 3;
+};
+
+enum class tile_kind {
+    none,
+    north_south_west,
+    north_south_east,
+    east_west_north,
+    east_west_south,
+    junction_north_west,
+    junction_north_east,
+    junction_south_west,
+    junction_south_east
+};
+
+struct grid {
+    std::optional<int> vertical;
+    std::optional<int> horizontal;
+    auto at(int x, int y) const -> tile_kind;
+};
+
+/// extent is the side length of an overmap, allowing isolated topology tests.
+auto plan_grid(const grid_options& opts, int extent) -> grid;
+
+} // namespace highway
