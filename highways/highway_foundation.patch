+            CHECK(generator.ter(point_omt_ms(10, 10)) == ter_id("t_pavement"));
+            CHECK(generator.ter(point_omt_ms(12, 12)) == ter_id("t_pavement"));
+            if (std::string_view(name).starts_with("ns_")
+                && std::string_view(suffix) != "_crossing") {
+                CHECK(generator.ter(point_omt_ms(name[3] == 'w' ? 7 : 16, 0))
+                      == ter_id("t_guardrail"));
+            }
+            if (std::string_view(name).starts_with("ew_")
+                && std::string_view(suffix) != "_crossing") {
+                CHECK(generator.ter(point_omt_ms(0, name[3] == 'n' ? 7 : 16))
+                      == ter_id("t_guardrail"));
+            }
+            ++index;
+        }
