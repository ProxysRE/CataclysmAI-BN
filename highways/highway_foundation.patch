@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Check highway JSON identifiers and actual pavement connectivity without loading a world."""
+from collections import deque
+from pathlib import Path
+import json
+
+ROOT = Path(__file__).resolve().parents[2]
+TERRAINS = json.loads((ROOT / 'data/json/overmap/overmap_terrain/bn_highways.json').read_text())
+MAPGENS = json.loads((ROOT / 'data/json/mapgen/bn_highways.json').read_text())
+rows = {x['om_terrain']: x['object']['rows'] for x in MAPGENS}
+assert len(rows) == len(MAPGENS) == len(TERRAINS) == 24
+assert set(rows) == {x['id'] for x in TERRAINS}
+for name, tile in rows.items():
+    assert len(tile) == 24 and all(len(row) == 24 for row in tile), name
+    assert set(''.join(tile)) <= set('g.*|'), name
+    assert any('.' in row for row in tile), name
+
+
+def joined(nw, ne, sw, se):
+    return [a + b for a, b in zip(nw, ne)] + [a + b for a, b in zip(sw, se)]
+
+
+def connected(tile, ports):
+    todo = deque([ports[0]])
+    visited = {ports[0]}
+    while todo:
+        x, y = todo.popleft()
