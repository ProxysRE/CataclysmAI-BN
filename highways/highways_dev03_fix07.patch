+TEST_CASE("dda_highway_interchange_field_uses_real_field_mapgen", "[highway][dda][mapgen]") {
+    clear_all_state();
+    const auto disabled = override_option("BN_HIGHWAYS", "false");
+    const auto city_size = override_option("CITY_SIZE", "0");
+    const auto address = point_abs_om(20, 20);
+    auto batch = overmap_special_batch(address, {});
+    ACTIVE_OVERMAP_BUFFER.create_custom_overmap(address, batch);
+    auto &om = ACTIVE_OVERMAP_BUFFER.get(address);
+    const auto local = tripoint_om_omt(40, 40, 0);
+    om.ter_set(local, oter_id("special_field_highway"));
+    const auto restore_mapgen = restore_on_out_of_scope<bool>(disable_mapgen);
+    disable_mapgen = false;
+    auto generator = mapgen_constructor(MAPBUFFER_REGISTRY.primary());
+    REQUIRE(generator.generate(project_combine(address, local), calendar::turn).is_generated());
+    auto field_floor_count = 0;
+    for( const auto x : std::views::iota(0, 24) ) {
+        for( const auto y : std::views::iota(0, 24) ) {
+            const auto terrain = generator.ter(point_omt_ms(x, y));
+            CHECK(terrain != ter_id("t_null"));
+            field_floor_count += terrain == ter_id("t_grass") || terrain == ter_id("t_dirt") ||
+                                 terrain == ter_id("t_grass_dead");
+        }
+    }
+    CHECK(field_floor_count > 0);
 }
 
