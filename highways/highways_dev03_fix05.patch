diff --git a/src/mapgen/nested_neighbor_flags.h b/src/mapgen/nested_neighbor_flags.h
new file mode 100644
index 0000000..c59f606
--- /dev/null
+++ b/src/mapgen/nested_neighbor_flags.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <array>
+
+#include "all_enum_values.h"
+#include "enum_conversions.h"
+#include "json.h"
+#include "line.h"
+#include "mapgendata.h"
+#include "overmap/omdata.h"
+
+#include <ranges>
+#include <unordered_map>
+#include <vector>
+
+namespace mapgen {
+
+/// DDA nested-mapgen flags: OR within each direction, AND across directions.
+/// flags_any instead accepts a match in any listed direction.
+class neighbor_flags {
+    std::unordered_map<direction, std::vector<oter_flags>> neighbors_;
+
+public:
+    explicit neighbor_flags( const JsonObject &object ) {
+        for( const auto dir : all_enum_values<direction>() ) {
+            auto flags = std::vector<oter_flags>{};
+            object.read( io::enum_to_string( dir ), flags );
+            if( !flags.empty() ) { neighbors_.emplace( dir, std::move( flags ) ); }
+        }
+    }
+
+    auto test( const mapgendata &data, const bool any_direction ) const -> bool {
+        const auto matches = [&data]( const auto &entry ) {
+            const auto terrain = data.neighbor_at( entry.first );
+            return std::ranges::any_of( entry.second, [terrain]( const auto flag ) { return terrain->has_flag( flag ); } );
+        };
+        return neighbors_.empty() || ( any_direction ? std::ranges::any_of( neighbors_, matches ) :
+                                      std::ranges::all_of( neighbors_, matches ) );
+    }
+};
+
+} // namespace mapgen
