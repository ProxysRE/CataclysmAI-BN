diff --git a/utilities/highway/check_dda_dependencies.py b/utilities/highway/check_dda_dependencies.py
new file mode 100644
index 0000000..3dbd391
--- /dev/null
+++ b/utilities/highway/check_dda_dependencies.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Validate the DDA highway dependency closure against the assembled BN data."""
+import argparse
+import json
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[2]
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--base-json', type=Path, default=root / 'data/json')
+args = parser.parse_args()
+terrain = set()
+palettes = set()
+nested = set()
+for directory in {args.base_json, root / 'data/json'}:
+    for path in directory.rglob('*.json'):
+        entries = json.loads(path.read_text(encoding='utf-8'))
+        if not isinstance(entries, list):
+            continue
+        for entry in entries:
+            if not isinstance(entry, dict):
+                continue
+            if entry.get('type') == 'overmap_terrain':
+                ids = entry.get('id', entry.get('abstract', []))
+                terrain.update([ids] if isinstance(ids, str) else ids)
+            if entry.get('type') == 'palette':
+                palettes.add(entry.get('id'))
+            if 'nested_mapgen_id' in entry:
+                nested.add(entry['nested_mapgen_id'])
+
+rotated = terrain | {identifier + '_' + suffix for identifier in terrain
+                     for suffix in ('north', 'east', 'south', 'west')}
+specials = json.loads((root / 'data/json/overmap/overmap_special/dda_highways.json').read_text())
+for special in specials:
+    for connection in special.get('connections', []):
+        assert 'terrain' not in connection, f"Deprecated connection in {special['id']}"
+        assert connection.get('connection') == 'local_road'
+    locations = special['overmaps']
+    if isinstance(locations, dict):
+        locations = locations.values()
+    for location in locations:
+        if 'overmap' not in location:
+            continue  # DDA clearance markers reserve space without replacing terrain.
+        assert location['overmap'] in rotated, f"Missing terrain: {location['overmap']}"
+for path in (root / 'data/json/mapgen/dda_highways').rglob('*.json'):
+    for entry in json.loads(path.read_text()):
+        assert entry['method'] == 'json', path
+        obj = entry['object']
+        for palette in obj.get('palettes', []):
+            assert palette in palettes, f'Missing palette: {palette}'
+        for placement in obj.get('place_nested', []):
+            for names in placement.get('neighbors', {}).values():
+                for name in [names] if isinstance(names, str) else names:
+                    assert name in terrain, f'Invalid neighbor terrain type: {name}'
+            for chunk in placement.get('chunks', []) + placement.get('else_chunks', []):
+                name = chunk if isinstance(chunk, str) else chunk[0]
+                assert name == 'null' or name in nested, f'Missing nested mapgen: {name}'
+print('PASS: highway special terrain, nested neighbor types, palettes, chunks and connection schema')
